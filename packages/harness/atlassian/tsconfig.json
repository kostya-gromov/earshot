{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles the page, so it resolves like a bundler rather than like Node.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    // @atlaskit/dropdown-menu's declarations import "react" without depending on its types, so
    // they would pick up the workspace's hoisted React 19 types. This page is React 18: point
    // every "react" import at its own copy. Type-checking only; Vite does not read this.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"]
    }
  },
  // Each system has its own React version, so each page type-checks with its own copy.
  "include": ["src", "vite.config.ts", "../shared"]
}
