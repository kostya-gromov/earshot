{
  "name": "@earshot/atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 4200",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc -p tsconfig.json && tsc -p figma/tsconfig.json",
