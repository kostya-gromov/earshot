    "test:visual": "playwright test --project visual",
    "budget": "node scripts/check-js-budget.ts"
  },
  "dependencies": {
    "@earshot/contracts": "workspace:*",
    "@earshot/reference": "workspace:*",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@figma/plugin-typings": "1.143.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
